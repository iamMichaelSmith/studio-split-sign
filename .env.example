PORT=5050
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:5050
DB_PROVIDER=sqlite
DB_PATH=./data/app.db
DATABASE_URL=
PGSSLMODE=disable
PG_SSL_REJECT_UNAUTHORIZED=false
PG_SSL_CA_PATH=
PDF_STORAGE=local
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=final-pdfs

# Change these before real use
ADMIN_USER=change-me
ADMIN_PASS=change-me-strong-password
SESSION_SECRET=change-me-long-random-string
SESSION_STORE=memory
REDIS_URL=
REDIS_PREFIX=splitsheet:sess:
COOKIE_SECURE=false
TRUST_PROXY=false
CSRF_PROTECTION_ENABLED=false
API_TOKEN_SECRET=change-me-separate-api-token-secret
PDF_LINK_SECRET=change-me-separate-pdf-link-secret
API_ACCESS_TOKEN_TTL_MINUTES=15
API_REFRESH_TOKEN_TTL_DAYS=30
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
AUTH_DEBUG_TOKENS=false
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=SplitSheet Studio Owner

# Optional social sign-in. Buttons activate only when both values exist.
# Google callback:  PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple callback:   PUBLIC_BASE_URL/auth/apple/callback
# APPLE_CLIENT_ID is the Apple Services ID.
# Option A: paste a generated Sign in with Apple client-secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Option B, preferred: let the app generate Apple client-secret JWTs from your Apple key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY can be used instead of APPLE_PRIVATE_KEY_PATH. Keep literal \n line breaks if storing in a secret manager.
APPLE_PRIVATE_KEY=

# SMTP path still works if you prefer it, but SES direct send is also supported.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SES direct-send path
SES_REGION=us-east-1
FROM_EMAIL=no-reply@blakmarigold.com
REPLY_TO_EMAIL=Blakmarigold@gmail.com
NOTIFY_EMAIL=Blakmarigold@gmail.com
SUPPORT_EMAIL=Blakmarigold@gmail.com
GA_MEASUREMENT_ID=
CONTACT_EXPORT_TOKEN=

# Storefront, subscriptions, and plugin updates
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_CREATOR_ANNUAL_PRICE_ID=
STRIPE_STUDIO_PRO_PRICE_ID=
STRIPE_STUDIO_ANNUAL_PRICE_ID=
# By default subscription checkout uses the plan prices in services/plan-service.js.
# Set true only when the Stripe Price IDs above are active recurring prices in the same Stripe mode as STRIPE_SECRET_KEY.
STRIPE_USE_CONFIGURED_PRICE_IDS=false
PLUGIN_VERSION_LABEL=0.1.2
PLUGIN_LATEST_VERSION_LABEL=0.1.2
PLUGIN_MINIMUM_SUPPORTED_VERSION=
PLUGIN_RELEASE_NOTES_URL=http://localhost:5050/pricing
PLUGIN_DOWNLOAD_URL=
PLUGIN_DOWNLOAD_BUCKET=
PLUGIN_DOWNLOAD_KEY=downloads/SplitSheetStudio-Setup-0.1.2.exe
MAC_PLUGIN_DOWNLOAD_ENABLED=false
MAC_PLUGIN_DOWNLOAD_URL=
MAC_PLUGIN_DOWNLOAD_BUCKET=
MAC_PLUGIN_DOWNLOAD_KEY=downloads/SplitSheetStudio-0.1.2-macOS.pkg
MAC_PLUGIN_DOWNLOAD_PATH=
