{
  "family": "splitsheetstudio-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/splitsheetstudioTaskRole",
  "containerDefinitions": [
    {
      "name": "splitsheetstudio-app",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/splitsheetstudio:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5050,
          "hostPort": 5050,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "5050" },
        { "name": "PUBLIC_BASE_URL", "value": "https://app.splitsheetstudio.com" },
        { "name": "DB_PROVIDER", "value": "postgres" },
        { "name": "PGSSLMODE", "value": "verify-full" },
        { "name": "PG_SSL_REJECT_UNAUTHORIZED", "value": "true" },
        { "name": "PG_SSL_CA_PATH", "value": "/opt/aws-rds/global-bundle.pem" },
        { "name": "PDF_STORAGE", "value": "s3" },
        { "name": "S3_BUCKET", "value": "splitsheetstudio-production-pdfs" },
        { "name": "S3_REGION", "value": "us-east-1" },
        { "name": "S3_PREFIX", "value": "final-pdfs" },
        { "name": "SESSION_STORE", "value": "redis" },
        { "name": "REDIS_PREFIX", "value": "splitsheet:sess:" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "TRUST_PROXY", "value": "true" },
        { "name": "CSRF_PROTECTION_ENABLED", "value": "true" },
        { "name": "ALLOW_PUBLIC_REGISTRATION", "value": "true" },
        { "name": "REQUIRE_EMAIL_VERIFICATION", "value": "true" },
        { "name": "AUTH_DEBUG_TOKENS", "value": "false" },
        { "name": "SIGNER_LINK_TTL_HOURS", "value": "168" },
        { "name": "AUTO_SIGNER_REMINDERS", "value": "true" },
        { "name": "SIGNER_REMINDER_AFTER_HOURS", "value": "24" },
        { "name": "SIGNER_REMINDER_INTERVAL_MINUTES", "value": "60" },
        { "name": "SES_REGION", "value": "us-east-1" },
        { "name": "FROM_EMAIL", "value": "no-reply@splitsheetstudio.com" },
        { "name": "REPLY_TO_EMAIL", "value": "blakmarigold@gmail.com" },
        { "name": "NOTIFY_EMAIL", "value": "blakmarigold@gmail.com" },
        { "name": "SUPPORT_EMAIL", "value": "Contact@blakmarigold.com" },
        { "name": "STRIPE_CREATOR_PRICE_ID", "value": "price_1UF2f6ISjA58kSWkuJmWx9da" },
        { "name": "STRIPE_CREATOR_ANNUAL_PRICE_ID", "value": "price_1UF2fZISjA58kSWkO8xExDHG" },
        { "name": "STRIPE_STUDIO_PRO_PRICE_ID", "value": "price_1UF2hPISjA58kSWklxV3Tgrr" },
        { "name": "STRIPE_STUDIO_ANNUAL_PRICE_ID", "value": "price_1UF2iuISjA58kSWkyP1fxZe1" },
        { "name": "PLUGIN_VERSION_LABEL", "value": "0.1.2" },
        { "name": "PLUGIN_LATEST_VERSION_LABEL", "value": "0.1.2" },
        { "name": "PLUGIN_MINIMUM_SUPPORTED_VERSION", "value": "" },
        { "name": "PLUGIN_RELEASE_NOTES_URL", "value": "https://splitsheetstudio.com/pricing" },
        { "name": "PLUGIN_DOWNLOAD_URL", "value": "" },
        { "name": "PLUGIN_DOWNLOAD_BUCKET", "value": "splitsheetstudio-production-pdfs" },
        { "name": "PLUGIN_DOWNLOAD_KEY", "value": "downloads/SplitSheetStudio-Setup-0.1.2.exe" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "<secrets-manager-database-url-arn>" },
        { "name": "SESSION_SECRET", "valueFrom": "<secrets-manager-session-secret-arn>" },
        { "name": "PDF_LINK_SECRET", "valueFrom": "<secrets-manager-pdf-link-secret-arn>" },
        { "name": "REDIS_URL", "valueFrom": "<secrets-manager-redis-url-arn>" },
        { "name": "API_TOKEN_SECRET", "valueFrom": "<secrets-manager-api-token-secret-arn>" },
        { "name": "ADMIN_USER", "valueFrom": "<secrets-manager-admin-user-arn>" },
        { "name": "ADMIN_PASS", "valueFrom": "<secrets-manager-admin-pass-arn>" },
        { "name": "OWNER_EMAIL", "valueFrom": "<secrets-manager-owner-email-arn>" },
        { "name": "OWNER_PASSWORD", "valueFrom": "<secrets-manager-owner-password-arn>" },
        { "name": "OWNER_DISPLAY_NAME", "valueFrom": "<secrets-manager-owner-display-name-arn>" },
        { "name": "CONTACT_EXPORT_TOKEN", "valueFrom": "<secrets-manager-contact-export-token-arn>" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "<secrets-manager-google-client-id-arn>" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "<secrets-manager-google-client-secret-arn>" },
        { "name": "APPLE_CLIENT_ID", "valueFrom": "<secrets-manager-apple-client-id-arn>" },
        { "name": "APPLE_TEAM_ID", "valueFrom": "<secrets-manager-apple-team-id-arn>" },
        { "name": "APPLE_KEY_ID", "valueFrom": "<secrets-manager-apple-key-id-arn>" },
        { "name": "APPLE_PRIVATE_KEY", "valueFrom": "<secrets-manager-apple-private-key-arn>" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "<secrets-manager-stripe-secret-key-arn>" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "<secrets-manager-stripe-webhook-secret-arn>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/splitsheetstudio",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:5050/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
