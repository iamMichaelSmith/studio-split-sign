<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Submitted</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <h1><%= title %></h1>
    <div class="card">
      <div class="stat-label">Saved</div>
      <h2>Split sheet submitted</h2>
      <p>Your split sheet was saved. If signature links were selected, contributors can approve from their own device. The final PDF stays available from your account vault.</p>
      <p><b>ID:</b> <%= id %></p>
      <% if (typeof songTitle !== 'undefined' && songTitle) { %>
        <p><b>Song:</b> <%= songTitle %> <% if (typeof version !== 'undefined' && version) { %>(v<%= version %>)<% } %></p>
      <% } %>

      <% if (emailResult && emailResult.ok) { %>
        <p style="color:#9be49b;"><b>Email status:</b> Sent successfully.</p>
      <% } else if (emailResult && emailResult.reason === 'smtp_not_configured') { %>
        <p style="color:#ffd48a;"><b>Email status:</b> SMTP is not configured. Set SMTP_USER + SMTP_PASS in .env to send copies automatically.</p>
      <% } else if (emailResult && emailResult.reason && emailResult.reason !== 'not_attempted') { %>
        <p style="color:#ffd48a;"><b>Email status:</b> Attempted but failed (<%= emailResult.reason %>).</p>
      <% } else { %>
        <p>Email notifications were attempted if SMTP is configured.</p>
      <% } %>

      <% if (type === 'split-sheet') { %>
        <div class="home-actions">
          <a class="button-link" href="/account#split-sheet-vault">Open vault</a>
          <a class="button-link button-link-secondary" href="<%= typeof pdfUrl !== 'undefined' ? pdfUrl : `/split-sheet/pdf/${id}` %>">Download PDF summary</a>
          <a class="button-link button-link-secondary" href="/split-sheet">Create another</a>
        </div>
      <% } %>
    </div>
    <p><a href="/account">Back to account</a></p>
  </div>
</body>
</html>
