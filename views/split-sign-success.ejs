<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Signature Submitted</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <h1>Signature Submitted</h1>
    <div class="card">
      <p><b>Song:</b> <%= doc.payload.songTitle %></p>
      <p><b>Contributor:</b> <%= signer.legalName %> (<%= signer.role %>)</p>
      <p><b>Status:</b> <%= everyoneSigned ? 'Completed' : 'Pending remaining signer(s)' %></p>
      <p><%= message %></p>
      <% if (everyoneSigned) { %>
        <% if (emailResult && emailResult.ok) { %>
          <p class="banner"><b>Delivery confirmed:</b> the completed packet was accepted by the email provider for every contributor.</p>
        <% } else if (emailResult) { %>
          <p class="form-error"><b>Email needs attention:</b> the packet is complete, but automatic delivery did not confirm successfully.</p>
        <% } %>
        <p><a href="/split-sheet/pdf/<%= doc.id %>">Download final packet</a></p>
      <% } else { %>
        <p>You can close this page. The completed copy will be emailed automatically after the remaining contributor signs.</p>
      <% } %>
    </div>
    <p><a href="/">Back to home</a></p>
  </div>
</body>
</html>
