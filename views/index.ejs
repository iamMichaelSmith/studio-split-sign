<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Split Sheet Studio</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <h1>Split Sheet Studio</h1>
    <p class="small">Hosted split-sheet workflow for session capture, signatures, delivery, and plugin-connected studio use.</p>
    <div class="home-actions">
      <a class="button-link" href="/login">Sign in</a>
      <a class="button-link button-link-secondary" href="/split-sheet">Start split sheet</a>
      <a class="button-link button-link-secondary" href="/beta">Download beta plugin</a>
    </div>
    <p class="small"><a href="/account">Account</a> · <a href="/pricing">Plans and plugin</a> · <a href="/blog">Blog</a> · <a href="mailto:<%= supportEmail %>">Support</a></p>

    <div class="grid">
      <div class="card">
        <h3>Split Sheet</h3>
        <p class="small">Capture co-writer splits, signatures, and recipient delivery in one pass.</p>
        <a href="/split-sheet">Open</a>
      </div>
      <div class="card">
        <h3>Get the Studio Toolkit</h3>
        <p class="small">Download the Windows VST3 beta and standalone app.</p>
        <a href="/beta">Download beta</a>
      </div>
      <div class="card">
        <h3>Rights Room</h3>
        <p class="small">Practical articles on split sheets, sync readiness, publishing data, and session workflow.</p>
        <a href="/blog">Read articles</a>
      </div>
    </div>

    <% if (typeof latestPosts !== 'undefined' && latestPosts.length) { %>
      <div class="card">
        <h2>Latest from the Rights Room</h2>
        <div class="grid">
          <% latestPosts.forEach((post) => { %>
            <div class="stat-card">
              <div class="stat-label"><%= post.category %></div>
              <h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="small"><%= post.excerpt %></p>
              <p class="small"><%= post.readingMinutes %> min read</p>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <p class="inline-actions">
      <a href="<%= forgotPasswordUrl %>">Forgot password</a>
      <a href="/admin/login">Admin login</a>
    </p>
  </div>
</body>
</html>
