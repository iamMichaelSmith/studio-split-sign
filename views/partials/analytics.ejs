<% if (typeof gaMeasurementId === "string" && gaMeasurementId) { %>
  <script nonce="<%= cspNonce %>" async src="https://www.googletagmanager.com/gtag/js?id=<%= encodeURIComponent(gaMeasurementId) %>"></script>
  <script nonce="<%= cspNonce %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaMeasurementId %>', { anonymize_ip: true });
  </script>
<% } %>
