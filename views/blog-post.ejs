<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= post.seoTitle %></title><meta name="description" content="<%= post.metaDescription %>">
  <% if (post.author) { %><meta name="author" content="<%= post.author.name %>"><% } %>
  <link rel="canonical" href="https://splitsheetstudio.com/blog/<%= post.slug %>"><meta name="theme-color" content="#171311">
  <meta property="og:type" content="article"><meta property="og:title" content="<%= post.seoTitle %>"><meta property="og:description" content="<%= post.metaDescription %>"><meta property="og:url" content="https://splitsheetstudio.com/blog/<%= post.slug %>"><meta property="og:image" content="<%= socialImageUrl %>"><meta property="article:published_time" content="<%= post.publishedAt %>">
  <% if (post.updatedAt) { %><meta property="article:modified_time" content="<%= post.updatedAt %>"><% } %>
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= post.seoTitle %>"><meta name="twitter:description" content="<%= post.metaDescription %>"><meta name="twitter:image" content="<%= socialImageUrl %>">
  <script nonce="<%= cspNonce %>" type="application/ld+json"><%- JSON.stringify(post.structuredData).replace(/</g, "\\u003c") %></script>
  <link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/premium.css">
</head>
<body class="premium-site"><div class="premium-shell">
  <%- include('partials/site-nav') %>
  <main class="premium-container article-page">
    <a class="article-back" href="<%= blogUrl %>">← Blog</a>
    <article class="premium-article">
      <header>
        <div class="pill"><%= post.category %></div>
        <h1><%= post.title %></h1>
        <p><%= post.excerpt %></p>
        <div class="journal-meta">
          <span>By <%= post.author ? post.author.name : 'Split Sheet Studio' %><% if (post.author) { %> | <%= post.author.jobTitle %> at <%= post.author.organization %><% } %></span>
          <span>Published <time datetime="<%= post.publishedAt %>"><%= post.publishedAt %></time></span>
          <% if (post.updatedAt) { %><span>Updated <time datetime="<%= post.updatedAt %>"><%= post.updatedAt %></time></span><% } %>
          <span><%= post.readingMinutes %> min read</span>
        </div>
      </header>
      <div class="blog-post-body"><%- post.bodyHtml %></div>
    </article>
    <% if (post.showPluginCta !== false) { %>
      <section class="blog-plugin-cta" aria-labelledby="blog-plugin-cta-title">
        <div class="blog-plugin-cta-copy">
          <div class="section-kicker">DAW workflow</div>
          <h2 id="blog-plugin-cta-title">Bring split sheets into the session.</h2>
          <p>Creator and Studio launch packages include the Windows VST3 plugin, standalone Windows app, browser workflow, secure remote signing, and final PDF delivery. No separate VST license is required.</p>
          <div class="blog-plugin-cta-actions"><a class="premium-button premium-button-primary" href="/pricing">Choose Creator or Studio</a><a class="premium-button premium-button-ghost" href="<%= appUrl %>/signup">Start free on the web</a></div>
        </div>
        <figure class="blog-plugin-cta-preview"><img src="/blog-plugin-contributors.png" width="1290" height="930" alt="Split Sheet Studio Windows VST3 plugin contributor and ownership split workflow" loading="lazy"><figcaption>Paid plans include the plugin during launch.</figcaption></figure>
      </section>
    <% } %>
    <section class="journal-cta">
      <div><h2><%= post.cta ? post.cta.title : 'Ready to document the session?' %></h2><p><%= post.cta ? post.cta.description : 'Create a split sheet, validate 100%, and send every signature link in one pass.' %></p></div>
      <a class="premium-button premium-button-primary" href="<%= appUrl %>/split-sheet"><%= post.cta ? post.cta.label : 'Start a split sheet →' %></a>
    </section>
  </main>
  <%- include('partials/site-footer') %>
</div></body></html>
