<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Account | Split Sheet Studio</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap account-wrap">
    <div class="timeline-top account-top">
      <div>
        <div class="stat-label">Signed in</div>
        <h1>Account</h1>
        <p class="small"><b><%= user.displayName %></b> · <%= user.email %></p>
        <% if (billingNotice === "success") { %><p class="small"><b>Billing updated.</b> Your plan will refresh after Stripe confirms the subscription.</p><% } %>
        <% if (billingNotice === "cancelled") { %><p class="small">Checkout was cancelled. Your current plan is unchanged.</p><% } %>
      </div>
      <form method="post" action="/logout"><button class="secondary-button" type="submit">Sign out</button></form>
    </div>

    <nav class="account-tabs" aria-label="Account sections">
      <% for (const tab of ["overview", "vault", "resources", "vst", "plans"]) { %>
        <a class="account-tab<%= accountTab === tab ? " active" : "" %>" href="/account?tab=<%= tab %>"<% if (accountTab === tab) { %> aria-current="page"<% } %>><%= tab === "vst" ? "VST" : tab.charAt(0).toUpperCase() + tab.slice(1) %></a>
      <% } %>
    </nav>

    <% if (accountTab === "overview") { %>
    <section class="card account-hero">
      <div>
        <div class="stat-label">Next session</div>
        <h2>Create the split sheet before the song leaves the room.</h2>
        <p class="small">Start with song details, add contributors, send signature links, then keep the final PDF in your vault.</p>
      </div>
      <div class="account-primary-actions">
        <% if (usage.canCreate) { %>
          <a class="button-link account-primary-button" href="<%= splitSheetUrl %>">Create split sheet</a>
        <% } else { %>
          <a class="button-link account-primary-button" href="/account?tab=plans">Upgrade to create more</a>
        <% } %>
        <a class="button-link button-link-secondary" href="/account?tab=vault">Open vault</a>
      </div>
    </section>

    <div class="account-summary-grid">
      <div class="card">
        <div class="stat-label">This month</div>
        <div class="stat-value"><%= usage.used %>/<%= usage.limit %></div>
        <p class="small"><%= usage.remaining %> split sheets remaining for <%= usage.window.label %>.</p>
      </div>
      <div class="card">
        <div class="stat-label">Current plan</div>
        <div class="stat-value"><%= usage.plan.name %></div>
        <p class="small"><%= usage.plan.description %></p>
        <% if (billingEnabled && user.stripeCustomerId) { %>
          <form method="post" action="/account/billing/portal"><button class="secondary-button" type="submit">Manage billing</button></form>
        <% } else { %>
          <p><a class="button-link button-link-secondary" href="/account?tab=plans">View plan options</a></p>
        <% } %>
      </div>
      <div class="card">
        <div class="stat-label">Get the plugin</div>
        <div class="stat-value">VST3</div>
        <p class="small">Bring splitsheets, credits, and session ownership into your Windows DAW workflow.</p>
        <p><a class="button-link button-link-secondary" href="/account?tab=vst">Get plugin</a></p>
      </div>
    </div>
    <% } %>

    <% if (accountTab === "vault") { %>
    <div id="split-sheet-vault" class="card">
      <div class="timeline-top">
        <div>
          <div class="stat-label">Your records</div>
          <h2>Your Split Sheet Vault</h2>
          <p class="small">View, download, and keep track of the split sheets you have created.</p>
        </div>
        <% if (usage.canCreate) { %><a class="button-link button-link-secondary" href="<%= splitSheetUrl %>">New split sheet</a><% } %>
      </div>
      <% if (!splitSheets.length) { %>
        <p class="small">No split sheets in the vault yet. Start your first split sheet when your session credits are ready.</p>
      <% } %>
      <% splitSheets.forEach((doc) => { %>
        <% const songName = (doc.payload && (doc.payload.songTitle || doc.payload.title || doc.payload.song || doc.payload.workTitle)) || "Untitled song"; %>
        <div class="timeline-item">
          <div class="timeline-top">
            <div>
              <div class="stat-label">Song name</div>
              <b><%= songName %></b>
              <div class="small"><%= doc.status %> · <%= doc.createdAt %> · ID <%= doc.id %></div>
            </div>
            <div class="vault-actions">
              <a href="<%= pdfViewPath(doc) %>" target="_blank" rel="noopener">View</a>
              <a href="<%= pdfDownloadPath(doc) %>">Download</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>

    <% if (accountTab === "resources") { %>
    <% if (latestPosts && latestPosts.length) { %>
      <div class="card">
        <div class="timeline-top">
          <div>
            <div class="stat-label">Rights Room</div>
            <h2>Guides for your next session</h2>
            <p class="small">Use these articles as the main learning source for split sheets, rights data, sync readiness, and DAW workflow.</p>
          </div>
          <a class="button-link button-link-secondary" href="<%= blogUrl %>">Read all</a>
        </div>
        <div class="grid">
          <% latestPosts.forEach((post) => { %>
            <div class="stat-card">
              <div class="stat-label"><%= post.category %></div>
              <h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="small"><%= post.excerpt %></p>
              <p class="small"><%= post.readingMinutes %> min read</p>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
    <% } %>

    <% if (accountTab === "vst") { %>
      <section class="card vst-download-page">
        <div class="vst-download-hero">
          <div class="vst-download-copy">
            <div class="stat-label">Get the plugin</div>
            <h2>Get Split Sheet Studio VST3 inside your DAW.</h2>
            <p class="vst-lede">Split Sheet Studio VST3 brings splitsheets, recording studio paperwork, producer credits, songwriter ownership, sync licensing prep, and final PDF delivery into the same workflow where the record is being made.</p>
            <div class="vst-keyword-row" aria-label="Plugin use cases">
              <span>Splitsheets</span>
              <span>Recording studio sessions</span>
              <span>Sync licensing prep</span>
              <span>Producer splits</span>
            </div>
            <div class="vst-actions">
              <% if (currentPlan.key === "free") { %>
                <a class="button-link account-primary-button" href="/account?tab=plans">Upgrade to get the plugin</a>
                <a class="button-link button-link-secondary" href="<%= pricingUrl %>">Compare Creator and Studio</a>
              <% } else { %>
                <a class="button-link account-primary-button" href="/downloads/plugin/latest">Download Windows installer</a>
                <a class="button-link button-link-secondary" href="/beta#windows-beta">Install guide</a>
              <% } %>
            </div>
            <% if (currentPlan.key === "free") { %>
              <p class="small">The plugin is included with Creator and Studio plans, so free users can upgrade when they are ready to close more sessions from the DAW.</p>
            <% } else { %>
              <p class="small">Your plan includes the Windows VST3 plugin and standalone Windows app during launch.</p>
            <% } %>
          </div>
          <figure class="vst-plugin-preview">
            <img src="/vst-contributors.png" width="1600" height="1214" alt="Split Sheet Studio VST3 plugin showing contributors, songwriter splits, producer shares, and session ownership fields inside a DAW workflow">
            <figcaption>Creator and Studio include the Windows VST3 plugin plus standalone app.</figcaption>
          </figure>
        </div>

        <div class="vst-benefit-grid" aria-label="Split Sheet Studio VST benefits">
          <article>
            <div class="stat-label">For studios</div>
            <h3>Close the session before files leave.</h3>
            <p class="small">Recording studios, engineers, and managers can capture splitsheets, legal names, roles, PRO data, and contributor emails while everyone is still focused on the song.</p>
          </article>
          <article>
            <div class="stat-label">For creators</div>
            <h3>Keep credits tied to the creative moment.</h3>
            <p class="small">Artists, producers, and songwriters can document publishing splits, master ownership, beat agreements, topline credits, and collaboration details without leaving the music workflow.</p>
          </article>
          <article>
            <div class="stat-label">For licensing</div>
            <h3>Make sync conversations easier.</h3>
            <p class="small">Clean ownership records, remote signatures, final PDF packets, and rights metadata help prepare songs for sync licensing, music publishing, catalog admin, and release paperwork.</p>
          </article>
        </div>

        <div class="vst-download-footer">
          <div>
            <div class="stat-label">Compatibility</div>
            <p class="small">Built for compatible 64-bit Windows VST3 hosts, with a standalone Windows app included for sessions outside the DAW.</p>
          </div>
          <a href="/beta#windows-beta">Installation guide and compatibility</a>
        </div>
      </section>
    <% } %>

    <% if (accountTab === "plans") { %>
    <div id="available-plans" class="card">
      <div class="timeline-top">
        <div>
          <div class="stat-label">Plan options</div>
          <h2>Upgrade when your session volume grows</h2>
          <p class="small">Use these plans when you need more monthly split sheets or the studio toolkit in your workflow.</p>
        </div>
      </div>
      <div class="grid">
        <% planOptions.forEach((plan) => { %>
          <div class="stat-card">
            <div class="stat-label"><%= plan.discountLabel || plan.priceLabel %></div>
            <h3><%= plan.name %></h3>
            <% if (plan.compareAtPriceLabel) { %>
              <p class="deal-price"><s><%= plan.compareAtPriceLabel %></s> <strong><%= plan.priceLabel %></strong></p>
            <% } else { %>
              <p class="deal-price"><strong><%= plan.priceLabel %></strong></p>
            <% } %>
            <p class="small"><%= plan.monthlySheetLimit %> split sheets/month</p>
            <% if (plan.annualPriceLabel) { %>
              <p class="small"><% if (plan.annualCompareAtPriceLabel) { %><s><%= plan.annualCompareAtPriceLabel %></s> <% } %><%= plan.annualPriceLabel %> annual launch option</p>
            <% } %>
            <p class="small"><%= plan.description %></p>
            <% if (plan.key === currentPlan.key) { %>
              <p class="plan-badge">Current plan</p>
            <% } else if (billingEnabled && plan.monthlyPriceUsdCents > 0) { %>
              <form method="post" action="/account/billing/checkout">
                <input type="hidden" name="planKey" value="<%= plan.key %>">
                <input type="hidden" name="billingInterval" value="month">
                <button type="submit">Upgrade to <%= plan.name %> monthly</button>
              </form>
              <% if (plan.annualPriceLabel) { %>
                <form method="post" action="/account/billing/checkout">
                  <input type="hidden" name="planKey" value="<%= plan.key %>">
                  <input type="hidden" name="billingInterval" value="year">
                  <button class="secondary-button" type="submit">Choose annual</button>
                </form>
              <% } %>
            <% } else if (plan.monthlyPriceUsdCents > 0) { %>
              <a class="button-link" href="<%= pricingUrl %>">Upgrade to <%= plan.name %></a>
              <p class="small">Paid checkout is temporarily unavailable in this environment. Please try again shortly or contact support.</p>
            <% } else { %>
              <a class="button-link button-link-secondary" href="<%= splitSheetUrl %>">Start free</a>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</body>
</html>
