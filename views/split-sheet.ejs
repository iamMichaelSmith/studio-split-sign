<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Split Sheet Studio</title><link rel="stylesheet" href="/style.css"></head><body><div class="wrap split-workflow-wrap"><div class="timeline-top"><div><div class="stat-label">New split sheet</div><h1>Document the session</h1><p class="small">Add the song, confirm contributors, then send signature links. Drafts autosave in this browser while you work.</p></div><div class="small"><% if (typeof user !== 'undefined' && user) { %>Signed in as <b><%= user.displayName %></b><br><a href="/account">Back to account</a><% } %></div></div><% if (typeof usage !== 'undefined' && usage) { %><div class="card usage-card"><b><%= usage.plan.name %></b> plan · <%= usage.used %>/<%= usage.limit %> split sheets used in <%= usage.window.label %> · <%= usage.remaining %> remaining</div><% } %><% if (error) { %><div class="card"><b><%= error %></b></div><% } %>

<div class="card workflow-helper">
  <div>
    <div class="stat-label">How this works</div>
    <p class="small">You can collect signatures by invite link, so nobody has to finish everything on this device. The final PDF appears in your account vault after the required approvals are complete.</p>
  </div>
  <a class="button-link button-link-secondary" href="/account#split-sheet-vault">View vault</a>
</div>

<div class="step-tabs">
  <button type="button" class="step-tab active" data-step-btn="1">1 Song</button>
  <button type="button" class="step-tab" data-step-btn="2">2 People</button>
  <button type="button" class="step-tab" data-step-btn="3">3 Send</button>
</div>

<% if (typeof revisionSource !== 'undefined' && revisionSource) { %>
  <div class="card legal-note">
    <h3>Revised split-sheet request</h3>
    <p>This starts a new version for <b><%= revisionSource.songTitle %></b>. The previous completed PDF remains preserved, and every contributor must sign this revised version before it becomes final.</p>
  </div>
<% } %>

<form method="post" action="/split-sheet" id="splitForm" autocomplete="on" novalidate>
  <% if (typeof revisionSource !== 'undefined' && revisionSource) { %>
    <input type="hidden" name="revisionOfId" value="<%= revisionSource.id %>">
    <input type="hidden" name="revisionOfVersion" value="<%= revisionSource.version %>">
  <% } %>
  <section class="step-panel" data-step="1">
    <div class="card">
      <div class="row">
        <div><label>Song title</label><input name="songTitle" required></div>
        <div><label>Alternate title (optional)</label><input name="alternateTitle"></div>
      </div>
      <div>
        <label>Rights covered by this split sheet</label>
        <select name="rightsScope" id="rightsScope">
          <option value="composition">Songwriting and publishing</option>
          <option value="master">Master recording ownership</option>
          <option value="composition-and-master">Songwriting/publishing and master ownership</option>
        </select>
        <p class="small">Choose master ownership only when this sheet is also dividing ownership of the sound recording.</p>
      </div>
      <div class="row">
        <div><label>Date</label><input type="date" name="date" required></div>
        <div><label>Session location</label><input name="sessionLocation" placeholder="Studio A / Remote"></div>
      </div>
      <div class="row">
        <div><label>ISWC (optional)</label><input name="iswc"></div>
        <div><label>ISRC (optional)</label><input name="isrc"></div>
      </div>
      <label>Notes (optional)</label><textarea name="notes" rows="3" placeholder="Any split/session context"></textarea>
      <button type="button" class="next-step" data-next="2">Continue to people</button>
    </div>
  </section>

  <section class="step-panel" data-step="2" style="display:none;">
    <div id="contributors"></div>
    <div class="card">
      <div class="row">
        <button type="button" id="add">Add contributor</button>
        <button type="button" id="setEqual">Set equal splits for all</button>
      </div>
      <p class="small">Tip: Add everyone who should approve the split. Saved collaborators appear in the selector on each card after you enter them once in this browser.</p>
    </div>
    <div class="row">
      <button type="button" class="next-step" data-next="3">Review and send</button>
      <button type="button" id="clearDraftBtn">Clear saved draft</button>
    </div>
  </section>

  <section class="step-panel" data-step="3" style="display:none;">
    <div class="card" id="reviewCard">
      <h3>Review before sending</h3>
      <div id="reviewSummary" class="small">Complete prior steps to preview details.</div>
    </div>
    <div class="card">
      <h3>Email recipients for signed copy</h3>
      <p class="small">Contributor emails are pre-selected. Add a manager, studio, label, or other recipient if they need the final copy.</p>
      <div id="recipientChecklist" class="small"></div>
      <div class="row">
        <div><label>Additional recipient #1</label><input type="email" name="recipientEmails" placeholder="email@example.com"></div>
        <div><label>Additional recipient #2</label><input type="email" name="recipientEmails" placeholder="email@example.com"></div>
      </div>
    </div>
    <div class="card legal-note">
      <label><input type="checkbox" name="supersedesPrevious" value="yes"> This split supersedes any previous draft for this song.</label>
      <label><input type="checkbox" id="allAgree" name="allPartiesAgree" value="yes" required> I confirm these proposed splits are ready to send. Every contributor must agree separately before finalization.</label>
      <label><input type="checkbox" id="collectByInvite" name="collectSignaturesByInvite" value="yes"> Send signature links so contributors can sign from their own device.</label>
      <div id="submitHint" class="small" style="margin-top:8px;color:#ffd48a;">Complete all required fields and signatures to enable submit.</div>
    </div>
    <button type="submit" id="submitBtn" disabled>Send split sheet</button>
  </section>
</form>

<div class="sticky-totals" id="stickyTotals">
  <div><strong>Writer Total:</strong> <span id="writerTotal">0</span>%</div>
  <div><strong>Publisher Total:</strong> <span id="publisherTotal">0</span>%</div>
  <div id="masterTotalWrap" style="display:none"><strong>Master Total:</strong> <span id="masterTotal">0</span>%</div>
  <div id="totalsStatus" class="small">Required totals must equal 100%</div>
</div>

<p><a href="/account">Back to account</a></p></div>
<script src="/vendor/signature_pad/signature_pad.umd.min.js"></script>
<script>
const DRAFT_KEY = 'splitSheetDraft.v1';
const COLLABORATOR_KEY = 'splitSheetCollaborators.v1';
const COLLABORATOR_FIELDS = ['legalName','role','address','phone','email','pro','ipi','publisherName','publisherIpi','typedSignatureName'];
const INVITE_OPTIONAL_FIELDS = new Set(['legalName','role','address','phone','pro','ipi','publisherName','publisherIpi']);
const pads = new Map();
const SERVER_PREFILL = <%- JSON.stringify(typeof prefill !== 'undefined' ? prefill : null).replace(/</g, '\\u003c') %>;

function saveDraft(){
  const fields = Array.from(document.querySelectorAll('#splitForm input, #splitForm textarea, #splitForm select')).filter((el) => !el.dataset.draftIgnore);
  const payload = fields.map((el) => ({
    type: el.type,
    value: el.type === 'checkbox' ? el.checked : el.value
  }));
  localStorage.setItem(DRAFT_KEY, JSON.stringify(payload));
}

function restoreDraft(){
  try {
    const raw = localStorage.getItem(DRAFT_KEY);
    if(!raw) return;
    const payload = JSON.parse(raw);
    const fields = Array.from(document.querySelectorAll('#splitForm input, #splitForm textarea, #splitForm select')).filter((el) => !el.dataset.draftIgnore);
    fields.forEach((el, idx) => {
      const entry = payload[idx];
      if(!entry) return;
      if(entry.type === 'checkbox') {
        el.checked = Boolean(entry.value);
      } else {
        el.value = entry.value || '';
      }
    });
  } catch {}
}

function clearDraft(){
  localStorage.removeItem(DRAFT_KEY);
  location.reload();
}

function collaboratorKey(profile){
  return String(profile.email || profile.legalName || profile.phone || '').trim().toLowerCase();
}

function readCollaborators(){
  try {
    const parsed = JSON.parse(localStorage.getItem(COLLABORATOR_KEY) || '[]');
    return Array.isArray(parsed) ? parsed.filter((profile) => profile && collaboratorKey(profile)).slice(0, 80) : [];
  } catch {
    return [];
  }
}

function writeCollaborators(profiles){
  localStorage.setItem(COLLABORATOR_KEY, JSON.stringify(profiles.slice(0, 80)));
}

function profileFromCard(card){
  const profile = {};
  COLLABORATOR_FIELDS.forEach((name) => {
    const node = card.querySelector(`[name="${name}"]`);
    profile[name] = String(node?.value || '').trim();
  });
  return profile;
}

function saveCollaboratorFromCard(card){
  const profile = profileFromCard(card);
  if(!profile.legalName || (!profile.email && !profile.phone)) return;
  const key = collaboratorKey(profile);
  const profiles = readCollaborators().filter((saved) => collaboratorKey(saved) !== key);
  profiles.unshift({ ...profile, updatedAt: new Date().toISOString() });
  writeCollaborators(profiles);
  renderCollaboratorSelectors(key);
}

function saveCollaboratorsFromForm(){
  document.querySelectorAll('.contributor-card').forEach(saveCollaboratorFromCard);
}

function escapeOptionText(value){
  return String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
}

function collaboratorOptionLabel(profile){
  const role = profile.role ? ` - ${profile.role}` : '';
  const email = profile.email ? ` (${profile.email})` : '';
  return `${profile.legalName || profile.email || profile.phone}${role}${email}`;
}

function renderCollaboratorSelectors(selectedKey){
  const profiles = readCollaborators();
  const options = profiles.map((profile) => {
    const key = collaboratorKey(profile);
    return `<option value="${escapeOptionText(key)}">${escapeOptionText(collaboratorOptionLabel(profile))}</option>`;
  }).join('');
  document.querySelectorAll('.collaborator-select').forEach((select) => {
    const currentValue = selectedKey || select.value;
    select.innerHTML = `<option value="">Select saved collaborator</option>${options}`;
    select.disabled = profiles.length === 0;
    select.value = profiles.some((profile) => collaboratorKey(profile) === currentValue) ? currentValue : '';
  });
}

function applyCollaboratorProfile(card, key){
  const profile = readCollaborators().find((saved) => collaboratorKey(saved) === key);
  if(!profile) return;
  COLLABORATOR_FIELDS.forEach((name) => {
    const node = card.querySelector(`[name="${name}"]`);
    if(node && profile[name] !== undefined) node.value = profile[name] || '';
  });
  const typed = card.querySelector('[name="typedSignatureName"]');
  const previewId = typed?.id ? typed.id.replace('typed', 'typedPreview') : '';
  const preview = previewId ? document.getElementById(previewId) : null;
  if(preview) preview.textContent = typed?.value || 'First Last';
  updateTotals();
  saveDraft();
}

function wirePad(canvasId,inputId,clearId){
  const canvas=document.getElementById(canvasId);if(!canvas)return;
  const hint=document.getElementById(`${canvasId}-hint`);
  const input=document.getElementById(inputId);
  if (typeof SignaturePad === 'undefined') {
    if (hint) hint.textContent = 'signature tool failed to load - refresh page';
    if (input) input.value = '';
    return;
  }
  const resize=()=>{const ratio=Math.max(window.devicePixelRatio||1,1);canvas.width=canvas.offsetWidth*ratio;canvas.height=canvas.offsetHeight*ratio;canvas.getContext('2d').scale(ratio,ratio);};
  resize();window.addEventListener('resize',resize);
  const pad=new SignaturePad(canvas,{backgroundColor:'rgb(255,255,255)'});
  pads.set(inputId, pad);

  if(input.value && input.value.startsWith('data:image/')){
    try { pad.fromDataURL(input.value); } catch {}
  }

  const sync=()=>{ const has=!pad.isEmpty(); input.value=has?pad.toDataURL():''; if(hint) hint.style.display=has?'none':'block'; renderReview(); saveDraft(); };
  canvas.addEventListener('mouseup',sync);
  canvas.addEventListener('touchend',sync);
  canvas.addEventListener('pointerup',sync);
  const btn=document.getElementById(clearId); if(btn) btn.addEventListener('click',()=>{pad.clear();sync();});
  sync();
}

let idx=0;const c=document.getElementById('contributors');
function add(prefill){
  const i = idx;
  c.insertAdjacentHTML('beforeend',`<details class="card contributor-card" open>
  <summary>Contributor #${i+1}</summary>
  <div class="collaborator-profile-row"><div><label>Saved collaborator</label><select class="collaborator-select" data-draft-ignore="true"><option value="">Select saved collaborator</option></select></div><p class="small">Profiles save automatically in this browser after you enter a legal name and email or phone.</p></div>
  <div class="row"><div><label>Legal name</label><input name="legalName" required></div><div><label>Role</label><input name="role" placeholder="artist / producer / writer" required></div></div>
  <div class="row"><div><label>Address</label><input name="address" required></div><div><label>Phone</label><input name="phone" required></div></div>
  <div class="row"><div><label>Email</label><input type="email" name="email" required></div><div><label>PRO</label><input name="pro" required></div></div>
  <div class="row"><div><label>IPI #</label><input name="ipi" required></div><div><label>Publisher name</label><input name="publisherName" required></div></div>
  <div class="row"><div><label>Publisher IPI #</label><input name="publisherIpi" required></div><div class="composition-field"><label>Writer share %</label><input type="number" step="0.01" name="writerShare" required></div></div>
  <div class="row"><div class="composition-field"><label>Publisher share %</label><input type="number" step="0.01" name="publisherShare" required></div><div class="master-field" style="display:none"><label>Master recording share %</label><input type="number" step="0.01" name="masterShare"></div></div>
  <div><label>Typed signature name</label><input name="typedSignatureName" id="typed${i}" placeholder="First Last"></div>
  <div><label>Signature preview (cursive)</label><div class="typed-signature-preview" id="typedPreview${i}">First Last</div></div>
  <h4>Draw signature</h4>
  <div class="sig-wrap"><canvas id="sig${i}" class="sig"></canvas><span class="sig-hint" id="sig${i}-hint">sign</span></div>
  <input type="hidden" id="sigData${i}" name="signatureData"><button type="button" id="clear${i}">Clear signature</button>
  </details>`);
  wirePad(`sig${i}`,`sigData${i}`,`clear${i}`);

  const card = c.lastElementChild;
  const typed=document.getElementById(`typed${i}`); const preview=document.getElementById(`typedPreview${i}`);
  const profileSelect = card.querySelector('.collaborator-select');
  profileSelect.addEventListener('change', () => applyCollaboratorProfile(card, profileSelect.value));
  typed.addEventListener('input',()=>{preview.textContent=(typed.value||'First Last'); renderReview(); saveDraft(); saveCollaboratorFromCard(card);});
  card.querySelectorAll('input,select,textarea').forEach(i=> i.addEventListener('input', () => { updateTotals(); saveDraft(); if(!i.dataset.draftIgnore) saveCollaboratorFromCard(card); }));

  if(prefill){
    const names = ['legalName','role','address','phone','email','pro','ipi','publisherName','publisherIpi','writerShare','publisherShare','masterShare','typedSignatureName','signatureData'];
    names.forEach((name) => {
      const node = card.querySelector(`[name="${name}"]`);
      if(node && prefill[name] !== undefined){ node.value = prefill[name]; }
    });
    if(prefill.typedSignatureName){ preview.textContent = prefill.typedSignatureName; }
    if(prefill.signatureData){
      const hidden = card.querySelector('[name="signatureData"]');
      hidden.value = prefill.signatureData;
      const pad = pads.get(hidden.id);
      if(pad){ try{ pad.fromDataURL(prefill.signatureData); }catch{} }
    }
  }

  idx++;
  renderCollaboratorSelectors(prefill ? collaboratorKey(prefill) : '');
  updateRightsFields();
  updateTotals();
}

function setNamedValue(name, value){
  const node = document.querySelector(`[name="${name}"]`);
  if(node) node.value = value || '';
}

function applyServerPrefill(prefill){
  if(!prefill) return false;
  localStorage.removeItem(DRAFT_KEY);
  ['songTitle','alternateTitle','date','sessionLocation','iswc','isrc','notes'].forEach((name) => {
    setNamedValue(name, prefill[name]);
  });
  const rights = document.getElementById('rightsScope');
  if(rights) rights.value = prefill.rightsScope || 'composition';
  const supersedes = document.querySelector('[name="supersedesPrevious"]');
  if(supersedes) supersedes.checked = true;
  const collect = document.getElementById('collectByInvite');
  if(collect) collect.checked = true;
  const allAgree = document.getElementById('allAgree');
  if(allAgree) allAgree.checked = false;

  c.innerHTML = '';
  idx = 0;
  pads.clear();
  const contributors = Array.isArray(prefill.contributors) && prefill.contributors.length ? prefill.contributors : [{}];
  contributors.forEach((contributor) => add({
    ...contributor,
    typedSignatureName: '',
    signatureData: ''
  }));
  updateRightsFields();
  updateTotals();
  renderReview();
  return true;
}

function getVals(name){ return Array.from(document.querySelectorAll(`[name="${name}"]`)).map(i=>i.value); }
function num(n){ return Number(n||0); }
function currentRightsScope(){ return document.getElementById('rightsScope').value || 'composition'; }
function includesComposition(){ return currentRightsScope() !== 'master'; }
function includesMaster(){ return currentRightsScope() !== 'composition'; }

function updateRightsFields(){
  document.querySelectorAll('.composition-field').forEach((wrap)=>{
    wrap.style.display = includesComposition() ? '' : 'none';
    const input = wrap.querySelector('input'); if(input) input.required = includesComposition();
  });
  document.querySelectorAll('.master-field').forEach((wrap)=>{
    wrap.style.display = includesMaster() ? '' : 'none';
    const input = wrap.querySelector('input'); if(input) input.required = includesMaster();
  });
  document.getElementById('masterTotalWrap').style.display = includesMaster() ? '' : 'none';
}

function totalsAreValid(){
  const w = getVals('writerShare').reduce((a,v)=>a+num(v),0);
  const p = getVals('publisherShare').reduce((a,v)=>a+num(v),0);
  const m = getVals('masterShare').reduce((a,v)=>a+num(v),0);
  const compositionValid = !includesComposition() || ((Math.round(w*100)/100 === 100) && (Math.round(p*100)/100 === 100));
  const masterValid = !includesMaster() || (Math.round(m*100)/100 === 100);
  return compositionValid && masterValid;
}

function setEqualSplits(){
  const writer = Array.from(document.querySelectorAll('input[name="writerShare"]'));
  const publisher = Array.from(document.querySelectorAll('input[name="publisherShare"]'));
  const master = Array.from(document.querySelectorAll('input[name="masterShare"]'));
  if(!writer.length) return;
  const each = Number((100 / writer.length).toFixed(2));
  writer.forEach((el) => el.value = each);
  publisher.forEach((el) => el.value = each);
  master.forEach((el) => el.value = each);

  const wTotal = writer.reduce((sum, el) => sum + Number(el.value || 0), 0);
  const pTotal = publisher.reduce((sum, el) => sum + Number(el.value || 0), 0);
  const mTotal = master.reduce((sum, el) => sum + Number(el.value || 0), 0);
  if(writer.length){ writer[writer.length - 1].value = (100 - (wTotal - Number(writer[writer.length - 1].value))).toFixed(2); }
  if(publisher.length){ publisher[publisher.length - 1].value = (100 - (pTotal - Number(publisher[publisher.length - 1].value))).toFixed(2); }
  if(master.length){ master[master.length - 1].value = (100 - (mTotal - Number(master[master.length - 1].value))).toFixed(2); }
  updateTotals();
  saveDraft();
}

function updateTotals(){
  const w = getVals('writerShare').reduce((a,v)=>a+num(v),0);
  const p = getVals('publisherShare').reduce((a,v)=>a+num(v),0);
  const m = getVals('masterShare').reduce((a,v)=>a+num(v),0);
  document.getElementById('writerTotal').textContent = w.toFixed(2).replace(/\.00$/,'');
  document.getElementById('publisherTotal').textContent = p.toFixed(2).replace(/\.00$/,'');
  document.getElementById('masterTotal').textContent = m.toFixed(2).replace(/\.00$/,'');
  const ok = totalsAreValid();
  const status = document.getElementById('totalsStatus');
  status.textContent = ok ? 'Looks good. Required totals are valid.' : 'Every selected rights total must equal exactly 100%.';
  status.style.color = ok ? '#9be49b' : '#ffd48a';
  renderReview();
}

function renderRecipientChecklist(){
  const list = document.getElementById('recipientChecklist');
  if(!list) return;
  const prev = new Map(Array.from(list.querySelectorAll('input[type="checkbox"][name="recipientEmails"]')).map(i => [i.value, i.checked]));
  const emails = getVals('email').filter(e => String(e||'').includes('@'));
  if(!emails.length){ list.innerHTML = '<p>No valid contributor emails yet.</p>'; return; }
  list.innerHTML = emails.map((e, i) => {
    const isChecked = prev.has(e) ? prev.get(e) : true;
    return `<label style="display:block;margin:4px 0;"><input type="checkbox" name="recipientEmails" value="${e}" ${isChecked ? 'checked' : ''}> Send copy to contributor #${i+1}: ${e}</label>`;
  }).join('');
}

function renderReview(){
  const names=getVals('legalName');
  const roles=getVals('role');
  const writer=getVals('writerShare');
  const publisher=getVals('publisherShare');
  const master=getVals('masterShare');
  const typed=getVals('typedSignatureName');
  const drawn=Array.from(document.querySelectorAll('[name="signatureData"]')).map(i=>!!i.value);
  const song = document.querySelector('[name="songTitle"]').value || '(missing song title)';

  const scopeLabel = currentRightsScope()==='master' ? 'Master recording ownership' : (currentRightsScope()==='composition-and-master' ? 'Songwriting/publishing and master ownership' : 'Songwriting and publishing');
  let html = `<p><b>Song:</b> ${song}</p><p><b>Rights covered:</b> ${scopeLabel}</p><ul>`;
  for(let i=0;i<names.length;i++){
    const compositionText = includesComposition() ? `Writer ${writer[i]||0}% / Publisher ${publisher[i]||0}%` : '';
    const masterText = includesMaster() ? `${compositionText ? ' / ' : ''}Master ${master[i]||0}%` : '';
    const email = getVals('email')[i] || '';
    html += `<li><b>${names[i]||email||'(missing name)'}</b> (${roles[i]||'role pending'}) - ${compositionText}${masterText} - Typed: ${typed[i]||'pending'} - Drawn: ${drawn[i]?'yes':'pending'}</li>`;
  }
  html += `</ul>`;
  document.getElementById('reviewSummary').innerHTML = html;
  renderRecipientChecklist();

  const w = Number(document.getElementById('writerTotal').textContent || 0);
  const p = Number(document.getElementById('publisherTotal').textContent || 0);
  const m = Number(document.getElementById('masterTotal').textContent || 0);
  const collectByInvite = !!document.getElementById('collectByInvite') && document.getElementById('collectByInvite').checked;
  const hasDrawn = drawn.every(Boolean) && drawn.length >= 2;
  const hasTyped = typed.every(v=>String(v||'').trim().length>1) && typed.length>=1;
  const checkedRecipients = Array.from(document.querySelectorAll('input[name="recipientEmails"][type="checkbox"]:checked')).length;
  const allAgree = !!document.getElementById('allAgree') && document.getElementById('allAgree').checked;
  const signaturesReady = collectByInvite ? true : (hasDrawn && hasTyped);
  const compositionValid = !includesComposition() || ((Math.round(w*100)/100===100) && (Math.round(p*100)/100===100));
  const masterValid = !includesMaster() || (Math.round(m*100)/100===100);
  const requiredReady = requiredFieldsReady();
  const valid = compositionValid && masterValid && signaturesReady && requiredReady && names.length>=2 && song !== '(missing song title)' && checkedRecipients>=1 && allAgree;
  document.getElementById('submitBtn').disabled = !valid;
  const hint=document.getElementById('submitHint');
  if(hint){
    const invalidField = firstInvalidRequiredField();
    hint.textContent = valid ? 'Ready to send for signatures.' : (invalidField ? `Finish required field: ${fieldLabel(invalidField)}.` : (collectByInvite ? 'Need valid 100% rights totals, at least 2 contributor emails, a recipient email, and proposal confirmation.' : 'Need valid 100% rights totals, at least 2 signed contributors, a recipient email, and agreement confirmation.'));
    hint.style.color = valid ? '#9be49b' : '#ffd48a';
  }
  return valid;
}

function fieldLabel(el){
  const label = el.closest('label') || (el.id ? document.querySelector(`label[for="${el.id}"]`) : null) || el.parentElement?.querySelector('label');
  return String(label?.textContent || el.name || 'required field').replace(/\s+/g, ' ').trim();
}

function firstInvalidRequiredField(){
  const form = document.getElementById('splitForm');
  const collectByInvite = !!document.getElementById('collectByInvite') && document.getElementById('collectByInvite').checked;
  return Array.from(form.querySelectorAll('[required]')).find((el) => {
    if(el.disabled || el.type === 'hidden') return false;
    if(collectByInvite && INVITE_OPTIONAL_FIELDS.has(el.name)) return false;
    if(el.type === 'checkbox') return !el.checked;
    return !String(el.value || '').trim() || !el.validity.valid;
  }) || null;
}

function requiredFieldsReady(){
  return !firstInvalidRequiredField();
}

function focusInvalidField(el){
  if(!el) return;
  const panel = el.closest('.step-panel');
  const step = panel?.dataset.step;
  if(step) goStep(step);
  setTimeout(() => {
    try { el.focus({ preventScroll: true }); } catch { try { el.focus(); } catch {} }
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 80);
}

function goStep(n){
  if(String(n)==='3' && !totalsAreValid()){
    alert('Cannot move to review until every selected rights total equals 100%.');
    return;
  }
  document.querySelectorAll('.step-panel').forEach(p=> p.style.display = p.dataset.step==String(n) ? '' : 'none');
  document.querySelectorAll('.step-tab').forEach(b=> b.classList.toggle('active', b.dataset.stepBtn==String(n)));
  window.scrollTo({ top: 0, behavior: 'smooth' });
  // Signature canvases are initialized while step 2 is hidden; trigger resize after panel switch.
  setTimeout(()=> window.dispatchEvent(new Event('resize')), 50);
  updateTotals();
}

document.querySelectorAll('.next-step').forEach(btn=> btn.addEventListener('click', ()=> goStep(btn.dataset.next)));
document.querySelectorAll('.step-tab').forEach(btn=> btn.addEventListener('click', ()=> goStep(btn.dataset.stepBtn)));

document.addEventListener('change', (e)=>{
  if(e.target && e.target.matches('input[name="recipientEmails"][type="checkbox"]')) renderReview();
  if(e.target && e.target.id === 'allAgree') renderReview();
  if(e.target && e.target.id === 'collectByInvite') renderReview();
  if(e.target && e.target.id === 'rightsScope') { updateRightsFields(); updateTotals(); }
  saveDraft();
});

document.getElementById('add').addEventListener('click', () => add());
document.getElementById('setEqual').addEventListener('click', setEqualSplits);
document.getElementById('clearDraftBtn').addEventListener('click', clearDraft);

const todayInput = document.querySelector('[name="date"]');
if(todayInput && !todayInput.value){ todayInput.value = new Date().toISOString().slice(0,10); }

document.querySelector('[name="songTitle"]').addEventListener('input', () => { renderReview(); saveDraft(); });

document.getElementById('splitForm').addEventListener('submit', (event) => {
  if(!renderReview()){
    event.preventDefault();
    const invalidField = firstInvalidRequiredField();
    if(invalidField){
      focusInvalidField(invalidField);
      const hint = document.getElementById('submitHint');
      if(hint){
        hint.textContent = `Finish required field: ${fieldLabel(invalidField)}.`;
        hint.style.color = '#ffd48a';
      }
    }
    return;
  }
  saveCollaboratorsFromForm();
  localStorage.removeItem(DRAFT_KEY);
});

if(!applyServerPrefill(SERVER_PREFILL)){
  add();
  restoreDraft();
}
updateRightsFields();
updateTotals();
</script></body></html>
